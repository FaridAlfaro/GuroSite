---
import NavBar from "./NavBar.astro";
import Footer from "../components/footer/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Guro</title>
		<script
			src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"
		></script>
	</head>
	<body>
		<NavBar>
			<slot />
			<Footer />
		</NavBar>
	</body>
	<script type="module">
		import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

		document.addEventListener("DOMContentLoaded", () => {
			const sections = document.querySelectorAll(".fade-section");
			const middleSections = document.querySelectorAll(".middle-section");

			const animateIn = (el) => {
				anime({
					targets: el,
					opacity: 1,
					easing: "easeOutQuad",
					duration: 400,
				});
			};

			const animateOut = (el) => {
				anime({
					targets: el,
					opacity: 0,
					easing: "easeOutQuad",
					duration: 100,
				});
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							animateIn(entry.target);

							if (
								entry.target.classList.contains(
									"middle-section",
								)
							) {
								document.body.style.backgroundColor = "var(--contrast)";
							}
						} else {
							animateOut(entry.target);

							if (
								entry.target.classList.contains(
									"middle-section",
								)
							) {
								document.body.style.backgroundColor = "var(--background)";
							}
						}
					});
				},
				{
					threshold: 0.5,
					rootMargin: "0px 0px 0px 0px",
				},
			);

			sections.forEach((section) => observer.observe(section));
		});
	</script>
</html>

<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=Fira+Sans:wght@100..900&family=Montserrat:wght@100..900&family=Space+Mono&display=swap");
  
	:root {
		--background: #f3f3f9;      /* Fondo general claro */
		--contrast: #010102;        /* Color principal */

		--azul3: #4f42e4;   /* Hover / íconos activos */
		--azul2: #7a73ec; /* Fondos secundarios */
		--azul1: #b4b1f7;    /* Fondo pastel / muy claro */

		--azul4: #2218b2;    /* Hover oscuro / contraste */
		--azul5: #1a1287;  /* Fondo profundo / modo oscuro */
		--gris2: #3b3b55;    /* Texto oscuro o complementario */
		--gris1: #e0e0f0;   /* Divisores o bordes sutiles */
	}
  
	html,
	body {
	  box-sizing: border-box;
	  padding: 0;
	  margin: 0;
	  font-family: "Montserrat", sans-serif;
	  font-weight: 00;
	  font-size: 14px;
	  overflow-x: hidden;
	}
  
	h1, h2, h3, h4, h5, h6 {
	  font-family: "Montserrat", sans-serif;
	}
  
	p, a, span, li, button, input, textarea {
	  font-family: "Montserrat", sans-serif;
	}
  
	.LogoText {
	  font-family: "Space Mono", monospace;
	}
  
	a, a:visited {
	  color: inherit;
	  text-decoration: none;
	  cursor: pointer;
	}
  
	.fade-section {
	  opacity: 0;
	  transition: opacity .1s ease;
	}
  
	@keyframes fade-up {
	  from {
		filter: blur(20px);
		opacity: 0;
	  }
	  to {}
	}
  
	@keyframes slide-up {
	  from {
		transform: translateY(-20vh);
	  }
	  to {}
	}
  
	@keyframes side {
	  from {
		filter: blur(5px);
		opacity: 0;
		filter: brightness(0);
	  }
	  to {}
	}
  
	.btn {
	  font-size: 1rem;
	  font-weight: 400;
	  text-decoration: none;
	  padding: 1rem;
	  color: var(--contrast);
	  border: 2px solid var(--contrast);
	  background: transparent;
	  transition: all 0.3s ease;
	}
  
	.btn-mod {
	  font-size: 1rem;
	  font-weight: 400;
	  text-decoration: none;
	  padding: 1rem;
	  color: var(--background);
	  border: 2px solid var(--background);
	  background: transparent;
	  transition: all 0.3s ease;
	}
  
	.btn:hover {
	  background: var(--contrast);
	  color: #fff;
	}
  
	.btn-mod:hover {
	  background: var(--background);
	  color: var(--contrast);
	}
	.lock-scroll {
 overflow: hidden !important;
 height: 100vh;
}
  </style>
  
