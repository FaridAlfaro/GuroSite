	<script type="module">
        // No necesitas importar anime.js aquí si solo lo usas para el background
        // import anime from 'https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js';

        const middleSections = document.querySelectorAll('.middle-section');
        const body = document.body;
        // Usamos un Set para rastrear las secciones que intersectan actualmente
        const intersectingMiddleSections = new Set();

        function handleIntersectionChanges(entries) {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    // Si la sección está intersectando, añadirla al Set
                    intersectingMiddleSections.add(entry.target);
                } else {
                    // Si la sección deja de intersectar, eliminarla del Set
                    intersectingMiddleSections.delete(entry.target);
                }
            });

            // Después de actualizar el Set, comprobar si alguna sección .middle-section está visible
            if (intersectingMiddleSections.size > 0) {
                // Si el Set no está vacío, añadir la clase (o mantenerla si ya estaba)
                body.classList.add('body-black');
            } else {
                // Si el Set está vacío, eliminar la clase
                body.classList.remove('body-black');
            }
        }

        const observerOptions = {
            root: null, // Observar en relación al viewport
            rootMargin: '0px',
            // Threshold muy bajo para detectar cualquier parte visible
            // Puedes ajustar ligeramente si 0 da problemas, ej: 0.01
            threshold: 0.1,
        };

        // Crear una única instancia del observer
        const observer = new IntersectionObserver(handleIntersectionChanges, observerOptions);

        // Observar cada sección .middle-section
        middleSections.forEach((section) => {
            observer.observe(section);
        });
    </script>
  </html>

<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=Fira+Sans:wght@100..900&family=Montserrat:wght@100..900&family=Space+Mono&display=swap");
  
	:root {
		--background: #f3f3f9;      /* Fondo general claro */
		--contrast: #010102;        /* Color principal */

		--azul3: #4f42e4;   /* Hover / íconos activos */
		--azul2: #7a73ec; /* Fondos secundarios */
		--azul1: #b4b1f7;    /* Fondo pastel / muy claro */

		--azul4: #2218b2;    /* Hover oscuro / contraste */
		--azul5: #1a1287;  /* Fondo profundo / modo oscuro */
		--gris2: #888888;    /* Texto oscuro o complementario */
		--gris1: #e0e0f0;   /* Divisores o bordes sutiles */
	}
  
	html,
	body {
	  box-sizing: border-box;
	  padding: 0;
	  margin: 0;
	  font-family: "Montserrat", sans-serif;
	  font-weight: 00;
	  font-size: 14px;
	  background-color: var(--background); /* Color inicial */
     /* La transición debe estar en el body para que se aplique al cambiar la clase */
     transition: background-color 0.3s ease, color 0.3s ease;
	 scrollbar-width: none;  /* Oculta la barra de scroll de Firefox */

	}
	body::-webkit-scrollbar {
    display: none;  /* Oculta la barra de scroll principal */
  }
	h1, h2, h3, h4, h5, h6 {
	  font-family: "Montserrat", sans-serif;
	  font-size: clamp(18px, 3.236vh, 60px);
	}
  
	p, li, button, input, textarea{
	  font-family: "Montserrat", sans-serif;
	  font-size: clamp(12px, 2vh, 28px);
	}
	a, label{
		font-size: clamp(12px, .9vh, 28px);
	}
	.LogoText {
	  font-family: "Space Mono", monospace;
	}
    @media (min-width: 720px) {
		h1, h2, h3, h4, h5, h6 {
		font-size: clamp(18px, 3.236vw, 60px);
	}
  
	p, li, button, input, textarea{
	  font-size: clamp(12px, 2vw, 28px);
	}
	a, label{
		font-size: clamp(12px, .9vw, 28px);
	}
	}
	a, a:visited {
	  color: inherit;
	  text-decoration: none;
	  cursor: pointer;
	}
  
	.fade-section {
	  opacity: 0;
	  transition: opacity .1s ease;
	}
	.body-black {
        background-color: var(--contrast); /* Usar la variable para el negro */
        color: var(--background); /* Cambiar color de texto para contraste */
    }
	.fade-section {
      opacity: 0; /* Opacidad inicial para la animación de entrada */
      /* Puedes mantener la transición si quieres un fade sutil además de la animación CSS */
      /* transition: opacity .1s ease; */
    }
	@keyframes fade-up {
	  0% {
		filter: blur(2px) brightness(0);
		opacity: 0;
	  }
	  50% {
		filter: brightness(2);	
	}
	}
  
	@keyframes slide-up {
	  from {
		transform: translateY(-20vh);
	  }
	  to {}
	}
  
	@keyframes side {
	  from {
		filter: blur(5px);
		opacity: 0;
		filter: brightness(0);
	  }
	  to {}
	}
  
	.btn {
	  font-weight: 400;
	  text-decoration: none;
	  padding: 1rem;
	  color: var(--contrast);
	  border-bottom: 2px solid var(--contrast);
	  background: transparent;
	  transition: all 0.3s ease;
	}
  
	.btn-mod {
	  font-weight: 400;
	  text-decoration: none;
	  padding: 1rem;
	  color: var(--background);
	  border-bottom: 2px solid var(--background);
	  background: transparent;
	  transition: all 0.3s ease;
	}
  
	.btn:hover {
	  background: var(--contrast);
	  color: #fff;
	}
  
	.btn-mod:hover {
	  background: var(--background);
	  color: var(--contrast);
	}
	.lock-scroll {
 overflow: hidden !important;
 height: 100vh;
}

  </style>
  
