<!-- HTML -->
<div class="navbar" id="navbar">
  <a href="/" class="logo-container">
    <img src="/logos/GuroBlanco.svg" alt="" />
  </a>
  <div class="burger" id="burger">
    <div class="burger-icon show" id="burgerIcon">Menú</div>
    <div class="close-icon hide" id="closeIcon">✕</div>
  </div>
</div>


<div class="menu-panel" id="menuPanel">
  <nav>
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/services">Servicios</a>
    <a href="/works">Trabajos</a>
    <a href="/contact">Contacto</a>
  </nav>
</div>


<slot />

<!-- CSS -->
<style>

  body.menu-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
    
  }

  .navbar {
    position: fixed;
    width: 100%;
    height: 10%;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    z-index: 100;
    opacity: 1;
    pointer-events: auto;
    animation: fondo-fondo linear both;
        animation-timeline: scroll(block);
        animation-range: entry 0% cover 50vh;
        
  }
  

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    margin-left: 2%;
    transition: opacity 0.3s ease;
    
  }
  .logo-container img {
    height: 60%;
    animation: fondo-color linear both;
    animation-timeline: scroll(block);
    animation-range: entry 0% cover 1vh;
  }

  .navbar.visible-navbar .logo-container {
    opacity: 1;
  }

  .burger {
    position: relative;
    width: auto;
    height: 100%;
    cursor: pointer;
    z-index: 101;
    margin-right: 3%;
    animation: fondo-color linear both;
    animation-timeline: scroll(block);
    animation-range: entry 0% cover 100vh;
  }

  .burger-icon,
  .close-icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
    color: var(--background);
    font-weight: normal;
    font-size: 1.618rem;
  }

 

  .burger-icon.show {
    opacity: 1;
    pointer-events: auto;
  }
  .burger-icon.hide {
    opacity: 0;
    pointer-events: none;
  }

  .close-icon.show {
    opacity: 1;
    pointer-events: auto;
    
  }
  .close-icon.hide {
    opacity: 0;
    pointer-events: none;
  }

  .slide {
    position: fixed;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 90;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    
  }

  .slide.active {
    pointer-events: auto;
    opacity: 1;
  }

  .slide.blue {
    background-color: black;
  }
  .slide.black {
    background-color: var(--background);
  }
  .slide.white {
    background-color: var(--contrast);
    z-index: 91;
  }

  .menu-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 92;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .menu-content.show {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-content nav {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .menu-content nav a {
    font-size: 1.618rem;
    font-weight: 400;
    color: var(--background);
    text-decoration: none;
    transition: transform ease 0.3s;
    letter-spacing: 2px;
  }

  nav a:hover {
    transform: translateX(5px);
  }
  @keyframes fondo-color {
  from{
    filter: brightness(1);
    color: var(--background);
  }
}
@keyframes fondo-img {
  from{
    opacity: 1;
  }
}
@keyframes fondo-fondo {
  to{
    background-color: var(--contrast);
  }
}
.menu-panel {
  position: fixed;
  top: -40vh;
  left: 0;
  width: 100%;
  height: 40vh;
  background-color: var(--background); 
  z-index: 99;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  transition: background-color 0.3s ease;
  pointer-events: none;
  border-radius: 0 0 20px 20px;
}
.menu-panel.active {
  pointer-events: auto;
}

.menu-panel nav {
  display: flex;
  flex-direction: row;
  gap: 30px;
}
.navbar {
  transition: transform 0.4s ease-in-out;
}

.navbar.navbar-hidden {
  transform: translateY(-100%);
}
@media (max-width: 767px)  {
  .navbar{
    height: 64px;
  }
  .menu-panel nav {
  display: flex;
  flex-direction: column;
  gap:1rem;
  margin-bottom: 2rem;
}
.menu-panel{
  justify-content: flex-end;
}
.menu-panel nav a {
  font-size: 1.618rem;
  font-weight: 400;
  color: var(--contrast);
  text-decoration: none;
  transition: transform ease 0.3s;
  letter-spacing: 2px;
}
.menu-panel nav a:hover {
  transform: translateX(5px);
}
.burger {
    position: relative;
    width: 20%;
    height: 100%;
    cursor: pointer;
    z-index: 101;
    margin-right: 0%;
    animation: fondo-color linear both;
    animation-timeline: scroll(block);
    animation-range: entry 0% cover 1vh;
  }

  .burger-icon,
  .close-icon {
  
    font-size: 1rem;
  }
}

</style>

<!-- JS -->
<script type="module">
  import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

  const burger = document.getElementById("burger");
  const burgerIcon = document.getElementById("burgerIcon");
  const closeIcon = document.getElementById("closeIcon");
  const menuPanel = document.getElementById("menuPanel");

  let isOpen = false;
  let scrollY = 0;

  burger.addEventListener("click", () => {
    if (!isOpen) {
      isOpen = true;

      // Congelar scroll sin moverlo
      scrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = "100%";

      burgerIcon.classList.remove("show");
      burgerIcon.classList.add("hide");
      closeIcon.classList.remove("hide");
      closeIcon.classList.add("show");

      anime({
        targets: menuPanel,
        top: "0",
        duration: 600,
        easing: "easeInOutCubic",
        begin: () => {
          menuPanel.classList.add("active");
        }
      });

    } else {
      isOpen = false;

      burgerIcon.classList.add("show");
      burgerIcon.classList.remove("hide");
      closeIcon.classList.add("hide");
      closeIcon.classList.remove("show");

      anime({
        targets: menuPanel,
        top: "-100vh",
        duration: 600,
        easing: "easeInOutCubic",
        complete: () => {
          menuPanel.classList.remove("active");

          // Restaurar scroll y desbloquear
          document.body.style.position = "";
          document.body.style.top = "";
          document.body.style.width = "";
          window.scrollTo(0, scrollY);
        }
      });
    }
  });
  let lastScroll = window.scrollY;
const navbar = document.getElementById("navbar");

window.addEventListener("scroll", () => {
  const currentScroll = window.scrollY;
  const isScrollingDown = currentScroll > lastScroll;
  const passedThreshold = currentScroll > window.innerHeight/5;

  if (passedThreshold) {
    if (isScrollingDown) {
      navbar.classList.add("navbar-hidden");
    } else {
      navbar.classList.remove("navbar-hidden");
    }
  }

  lastScroll = currentScroll;
});
</script>

