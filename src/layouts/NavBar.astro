</style>

<!-- JS -->
<script type="module">
  import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

  const burger = document.getElementById("burger");
  const burgerIcon = document.getElementById("burgerIcon");
  const closeIcon = document.getElementById("closeIcon");
  const menuPanel = document.getElementById("menuPanel");
  const navbar = document.getElementById("navbar");


  let isOpen = false;
  let scrollY = 0;

  burger.addEventListener("click", () => {
    if (!isOpen) {
      isOpen = true;

      // Congelar scroll sin moverlo
      scrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = "100%";

      burgerIcon.classList.remove("show");
      burgerIcon.classList.add("hide");
      closeIcon.classList.remove("hide");
      closeIcon.classList.add("show");

      anime({
        targets: menuPanel,
        top: "0",
        duration: 600,
        easing: "easeInOutCubic",
        begin: () => {
          menuPanel.classList.add("active");
        }
      });

    } else {
      isOpen = false;

      burgerIcon.classList.add("show");
      burgerIcon.classList.remove("hide");
      closeIcon.classList.add("hide");
      closeIcon.classList.remove("show");

      anime({
        targets: menuPanel,
        top: "-40vh", // Assuming the panel height is 40vh based on your CSS
        duration: 600,
        easing: "easeInOutCubic",
        complete: () => {
          menuPanel.classList.remove("active");

          // Restaurar scroll y desbloquear
          document.body.style.position = "";
          document.body.style.top = "";
          document.body.style.width = "";
          window.scrollTo(0, scrollY);
        }
      });
    }
  });

  let lastScroll = window.scrollY;
  let scrollUpDistance = 0; // Track distance scrolled upwards
  let lastScrollDirection = 'down'; // Keep track of the last scroll direction

  window.addEventListener("scroll", () => {
    const currentScroll = window.scrollY;
    const isScrollingDown = currentScroll > lastScroll;
    const passedThreshold = currentScroll > window.innerHeight / 5; // This threshold is for hiding when scrolling down initially

    // Calculate 5vh in pixels
    const tolerance = window.innerHeight * 0.5; // 5% of viewport height

    if (isScrollingDown) {
      // If scrolling down
      if (lastScrollDirection === 'up') {
        // Reset upward scroll distance if direction changes
        scrollUpDistance = 0;
      }
      if (passedThreshold) {
        navbar.classList.add("navbar-hidden");
      }
      lastScrollDirection = 'down';
    } else {
      // If scrolling up
      if (lastScrollDirection === 'down') {
        // Set a new reference point when scrolling up starts
        scrollUpDistance = 0; // Reset distance for the new upward scroll
      }

      // Calculate the distance scrolled upwards in this continuous upward movement
      scrollUpDistance += lastScroll - currentScroll;

      // Only show the navbar if the upward scroll distance exceeds the tolerance
      if (scrollUpDistance >= tolerance || currentScroll === 0) { // Also show if at the very top of the page
         navbar.classList.remove("navbar-hidden");
      }
      lastScrollDirection = 'up';
    }

    lastScroll = currentScroll;
  });
</script>

