<!-- CSS -->
<style>
  a{
    color: var(--background);
    font-size: clamp(18px, 4vh, 40px);
    color: var(--gris2);
    font-weight: 500;
    transition: ease .5s;
  }
  a:visited{
    color: var(--gris2);
  }
  a:hover{
    color: var(--background);
  }
  /* Existing CSS */
  body.menu-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }

  /* Add a class to body when at the top of the page */
  body.scrolled-top {
    /* This class is just a marker for CSS, no specific styles needed here */
  }

  .navbar {
    position: fixed;
    width: 100%;
    height: 10%;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 100;
    opacity: 1;
    pointer-events: auto;
   background-color: var(--contrast);
    transition: transform 0.4s ease-in-out; /* Keep existing transition for slide effect */
  }

  .navbar.navbar-hidden {
    transform: translateY(-100%);
  }

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    margin-left: 2%;
    transition: opacity 0.3s ease;
  }

  .logo-container img {
    height: 60%;
    
  }

  .navbar.visible-navbar .logo-container {
    opacity: 1;
  }

  .burger {
    position: relative;
    width: auto;
    height: 100%;
    cursor: pointer;
    z-index: 101;
    margin-right: 3%;

  }

  .burger-icon,
  .close-icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
    color: var(--background); /* Burger icon color is already correct */
    font-weight: normal;
  }

  .burger-icon.show {
    opacity: 1;
    pointer-events: auto;
  }

  .burger-icon.hide {
    opacity: 0;
    pointer-events: none;
  }

  .close-icon.show {
    opacity: 1;
    pointer-events: auto;
  }

  .close-icon.hide {
    opacity: 0;
    pointer-events: none;
  }

  .slide {
    position: fixed;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 90;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .menu-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 92;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .menu-content.show {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-content nav {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }



  


  .menu-panel {
    position: fixed;
    top: -40vh;
    left: 0;
    width: 100%;
    max-width: 100vw;
    height: 40vh;
    background-color: var(--contrast);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition:
      background-color 0.3s ease,
      top 0.6s easeInOutCubic; /* Add transition for 'top' property */
    pointer-events: none;
    /* Add border for separator when active */
    border-bottom: 0px solid var(--background); /* Default border */
  }

  .menu-panel.active {
    pointer-events: auto;
    width: 100%;
    max-width: 100vw;
    /* Add border when menu is active */
    border-bottom: 1px solid var(--background); /* Separator line */
  }

  .menu-panel nav {
    display: flex;
    flex-direction: row;
    gap: 30px;
  }

  @media (max-width: 767px) {
    a{
    color: var(--background);
    font-size: 1.618rem;
    color: var(--gris2);
    font-weight: 500;
    transition: ease .5s;
  }
  a:visited{
    color: var(--gris2);
  }
  a:hover{
    color: var(--background);
  }
