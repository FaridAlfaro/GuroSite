---
interface Props{
    id: number|string;
    title: string;
    text: string;
    price: string;
    link: string;
    image: string;
}
const {id, title, text, price, link, image} = Astro.props;
---

<a href={`/service/${title}`} class="container">
    <div class="text-container">
        <h3>{title}</h3>
        <span>(About)</span>
        <p>{text}</p>
        <strong class="btn-mod">{price}</strong>
    </div>
    {image && <img src={image} alt={`Imagen para el servicio ${title}`} />}

</a>




<style>
.container img {
        height: 25;
            width: 50vw;
        object-fit: cover; /* Asegura que la imagen cubra el área sin distorsionarse */
        border-radius: 1.2rem;
    }
    .container{
        width: 90%;
        display: flex;
        flex-direction: row-reverse;
        justify-content: space-between;
        color: var();
        animation: side ease-in-out both;
        animation-timeline: view();
        animation-range: 0% 50%;
        margin: 10vh 0;
    }

    @keyframes side {
        from{
            filter: opacity(0);
        }
        to{
            filter: opacity(1);
        }
    }
    
    .text-container{
        height: 100%;
        width: 30%;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        color: var(--background);
        h3{
            font-weight: bold;
        }
        p, span{  
            color: var(--gris2);
        }
    }
    @media (max-width: 768px) {
        .container{
            flex-direction: column;
        }
        .container img{
            height: auto;
            width: auto;
        }
        .text-container{
            width: auto;
            height: auto;
            margin: 10% 5%;
        }
    }
</style>