---
// src/components/ServicesSection.astro
import {  useEffect, useRef } from 'astro:hooks'; // Import useRef

---

<section class="services-wrapper">
  <section class="card-container" id="card-container">
    <section class="card card-1">
      <h1>Web Development</h1>
      <img src="/web-dev-image.svg" alt="Web Development Illustration" />
      <p>
        We craft stunning and functional websites tailored to your business needs.
        From e-commerce platforms to corporate sites, we've got you covered.
      </p>
    </section>
    <section class="card card-2">
      <h1>Branding</h1>
      <img src="/branding-image.svg" alt="Branding Illustration" />
      <p>
        Establish a powerful brand identity that resonates with your target
        audience. We offer logo design, brand strategy, and marketing materials.
      </p>
    </section>
    <section class="card card-3">
      <h1>AI Automation</h1>
      <img src="/ai-image.svg" alt="AI Automation Illustration" />
      <p>
        Leverage the power of artificial intelligence to automate your business
        processes. We create custom AI solutions for efficiency and growth.
      </p>
    </section>
  </section>

  <div class="spacer"></div>
</section>

<style>
  :root {
    --safe-height: 100vh;
    /* se recalcula con JS */
  }

  .services-wrapper {
    position: relative; /* Changed from fixed */
    width: 100%;
    /* height: var(--safe-height); */ /* Not needed here */
    /* top: 0;
    left: 0; */
  }

  .spacer {
    height: 300vh;
    width: 100%; /* Ensure full width */
  }

  .card-container {
    /* position: fixed; */ /* Removed fixed */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--safe-height);
    pointer-events: none;
    overflow: hidden;
  }

  .card {
    position: absolute;
    top: 10vh;
    left: 5vw;
    width: 90vw;
    height: 80vh;
    padding: 1.5rem;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    transform: translateY(100%);
    transition: transform 0.4s ease;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .card-1 {
    background-color: #00ffaf;
    z-index: 1;
    transform: translateY(0%);
  }

  .card-2 {
    background-color: #00c9ff;
    z-index: 2;
    top: 15vh;
    /* Overlap */
  }

  .card-3 {
    background-color: #ff5e00;
    z-index: 3;
    top: 20vh;
    /* More overlap */
  }

  h1 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    color: white;
    text-align: center;
  }

  p {
    font-size: 1rem;
    line-height: 1.4;
    color: white;
    text-align: center;
  }

  img {
    max-width: 80%;
    max-height: 50%;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  @media (max-width: 600px) {
    .card {
      top: 5vh;
      height: 90vh;
      /* Mobile height */
      padding: 1rem;
    }

    h1 {
      font-size: 1.2rem;
    }

    p {
      font-size: 0.9rem;
    }
  }
</style>

<script type="module">
  import anime from 'https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js';

  const fixVH = () => {
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--safe-height', `${vh * 100}px`);
  };

  fixVH();

  window.addEventListener('resize', fixVH);
  window.addEventListener('orientationchange', fixVH);

  const animCard2 = anime({
    targets: '.card-2',
    translateY: ['100%', '0%'],
    easing: 'easeInOutCubic',
    autoplay: false,
    duration: 800,
  });

  const animCard3 = anime({
    targets: '.card-3',
    translateY: ['100%', '0%'],
    easing: 'easeInOutCubic',
    autoplay: false,
    duration: 800,
  });

  function getScrollProgress() {
    const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
    return scrollTop / scrollHeight;
  }

  let animationStarted = false;
  const container = document.getElementById('card-container'); // Get the container

  window.addEventListener('scroll', () => {
    const progress = getScrollProgress();
    const body = document.body;

    const containerTop = container.offsetTop;
    const containerBottom = containerTop + container.offsetHeight;
    const scrollPos = window.scrollY + (window.innerHeight / 2); // Center of viewport

    if (scrollPos > containerTop && scrollPos < containerBottom && !animationStarted) {
      animationStarted = true;
      body.classList.add('lock-scroll');
      animCard2.seek((progress) / 0.33 * animCard2.duration);
      animCard3.seek(0);
    } else if (progress >= 0.33 && progress < 0.66 && animationStarted) {
      animCard2.seek((progress - 0.33) / 0.33 * animCard2.duration);
      animCard3.seek(0);
    } else if (progress >= 0.66 && animationStarted) {
      animCard2.seek(animCard2.duration);
      animCard3.seek((progress - 0.66) / 0.34 * animCard3.duration);
    }

    if (progress >= 0.99 && animationStarted) {
      animationStarted = false;
      body.classList.remove('lock-scroll');
    }
  });
</script>