<section>
  <article class="service">
    <div class="text">
      <div class="title">
        <h2 id="slide-title" class="slide-text">Title example</h2>
        <span id="slide-span" class="slide-text">span example</span>
      </div>
      <div class="texts">
        <p id="slide-text" class="slide-text">
          Lorem ipsum dolor sit amet consectetur adipisicing elit.
        </p>
        <a href="#" id="slide-btn" class="btn-mod slide-text">btn example</a>
      </div>
    </div>

    <div class="service-img">
      <img src="/slider/pageA.jpg" alt="Slide 1" class="slide-img active" />
      <img src="/slider/pageB.webp" alt="Slide 2" class="slide-img" />
      <img src="/slider/pageA.jpg" alt="Slide 3" class="slide-img" />
    </div>
  </article>

  <div class="controls-container">
    <button class="prev">←</button>
    <button class="next">→</button>
  </div>
</section>

<style>
  section {
    height: 100vh;
    width: 100%;
    color: var(--background);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: var(--contrast);
  }

  .controls-container {
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;
    width: 90%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
    /* No padding lateral, solo margen desde el borde */
  }

  .prev,
  .next {
    background: rgba(255,255,255,0.15);
    border: none;
    color: var(--background);
    cursor: pointer;
    font-size: 2.2rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: all;
    border-radius: 50%;
    transition: background 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .prev:hover,
  .next:hover {
    background: rgba(255,255,255,0.35);
    color: var(--contrast);
  }
  .prev:active,
  .next:active {
    background: rgba(255,255,255,0.5);
    color: var(--background);
  }

  .service {
    height: 80vh;
    width: 70vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    background: rgba(255,255,255,0.03);
    border-radius: 1.2em;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    padding: 2rem 0;
  }

  .text {
    display: flex;
    flex-direction: column;
    width: 40%;
    height: 90%;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 320px;
    max-width: 500px;
  }

  .title h2 {
    font-weight: 500;
    font-size: 2.2rem;
    margin-bottom: 0.7rem;
    line-height: 1.1;
    word-break: break-word;
    max-width: 100%;
  }

  .title span {
    font-size: 1.1rem;
    margin-left: 0;
    opacity: 0.7;
    display: block;
    word-break: break-word;
    max-width: 100%;
  }

  .texts p {
    line-height: 1.5;
    font-size: 1.05rem;
    max-width: 100%;
    word-break: break-word;
    margin-bottom: 0.5rem;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .btn-mod {
    width: fit-content;
    padding: 0.7em 1.3em;
    color: var(--background);
    text-decoration: none;
    transition: background 0.3s, color 0.3s;
    background: var(--contrast);
    border-radius: 0.5em;
    font-size: 1rem;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    border: 1px solid var(--background);
  }

  .btn-mod:hover {
    background: var(--background);
    color: var(--contrast);
    border-color: var(--contrast);
  }

  .service-img {
    height: 80vh;
    width: 60vh;
    max-width: 50%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-img img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.18);
    will-change: opacity;
    border-radius: 0.7em;
  }

  .service-img img.active {
    opacity: 1;
    z-index: 3;
  }

  /* --- Media Queries para Responsividad --- */
  @media screen and (max-width: 768px) {
    section {
      height: auto;
      min-height: 100vh;
      width: 100vw;
      padding: 0;
      background: var(--contrast);
      display: block;
    }

    .service {
      flex-direction: column;
      width: 100vw;
      min-height: 100vh;
      height: auto;
      gap: 0;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
      background: transparent;
      align-items: stretch;
      justify-content: flex-start;
    }

    .text {
      width: 100vw;
      max-width: 100vw;
      min-width: 0;
      padding: 2.2rem 1.2rem 1.2rem 1.2rem;
      height: auto;
      gap: 1.2rem;
      align-items: flex-start;
      justify-content: flex-start;
      background: rgba(255,255,255,0.07);
      border-radius: 0 0 1.2em 1.2em;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    }

    .title h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      letter-spacing: 0.01em;
      line-height: 1.2;
      max-width: 100%;
      word-break: break-word;
    }

    .title span {
      font-size: 0.95rem;
      margin-left: 0;
      opacity: 0.7;
      max-width: 100%;
      word-break: break-word;
    }

    .texts p {
      font-size: 1rem;
      line-height: 1.4;
      margin-bottom: 0.5rem;
      max-width: 100%;
      word-break: break-word;
    }

    .texts {
      gap: 0.7rem;
      width: 100%;
    }

    .btn-mod {
      width: 100%;
      font-size: 1rem;
      text-align: center;
      margin-top: 0.7rem;
      padding: 0.9em 0;
      border-radius: 0.5em;
      box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    .service-img {
      width: 100vw;
      height: 45vw;
      max-width: 100vw;
      min-height: 220px;
      margin: 0;
      border-radius: 0;
      box-shadow: none;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
    }

    .service-img img {
      border-radius: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.09);
      position: absolute;
      left: 0;
      top: 0;
      width: 100vw;
      height: 100%;
      object-fit: cover;
      min-height: 220px;
      max-height: 320px;
    }

    .controls-container {
      position: absolute;
      bottom: 2.5rem;
      left: 5vw;
      right: 5vw;
      width: 90vw;
      top: unset;
      display: flex;
      justify-content: space-between;
      gap: 0;
      pointer-events: none;
      z-index: 10;
    }

    .prev,
    .next {
      font-size: 2rem;
      width: 44px;
      height: 44px;
      background: rgba(255,255,255,0.18);
      color: var(--background);
      border-radius: 50%;
      pointer-events: all;
      box-shadow: 0 1px 6px rgba(0,0,0,0.09);
    }
  }
</style>

<script type="module">
  import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

  const slidesData = [
    {
      title: "Web Services",
      span: "Web Development - Web Design - E-commerce - SEO",
      text: "We develop web solutions with scalable technologies adapted to the needs of the brand.",
      btnText: "More info",
      btnLink: "/services",
    },
    {
      title: "Creative Services",
      span: "Branding - Graphic Design - Content Creation",
      text: "We create unforgettable brands and designs that communicate values ​​and meet company objectives.",
      btnText: "More info",
      btnLink: "/services",
    },
    {
      title: "Consulting Services",
      span: "Re-branding - Digital Strategy - Technical Advice",
      text: "We plan and produce solutions to brand problems.",
      btnText: "More info",
      btnLink: "/services",
    },
  ];

  const images = document.querySelectorAll(".slide-img");
  const texts = document.querySelectorAll(".slide-text");
  const nextBtn = document.querySelector(".next");
  const prevBtn = document.querySelector(".prev");
  let index = 0;

  function updateContent(idx) {
    const data = slidesData[idx];
    document.getElementById("slide-title").textContent = data.title;
    document.getElementById("slide-span").textContent = data.span;
    document.getElementById("slide-text").textContent = data.text;
    const btn = document.getElementById("slide-btn");
    btn.textContent = data.btnText;
    btn.href = data.btnLink;
  }

  function animate(direction) {
    if (anime.running.length) return;

    const isNext = direction === "next";
    const oldIndex = index;

    index = (index + (isNext ? 1 : slidesData.length - 1)) % slidesData.length;

    anime({
      targets: images[oldIndex],
      opacity: 0,
      zIndex: 1,
      duration: 300,
      easing: "easeOutQuad",
      complete: () => {
        images[oldIndex].classList.remove("active");
        anime({
          targets: images[index],
          opacity: 1,
          zIndex: 3,
          duration: 300,
          easing: "easeInQuad",
          complete: () => {
            images[index].classList.add("active");
          }
        });
      }
    });

    anime({
      targets: texts,
      opacity: [0, 1],
      duration: 300,
      easing: "easeInOutQuad",
      begin: () => {
        updateContent(index);
      }
    });
  }

  nextBtn.addEventListener("click", () => animate("next"));
  prevBtn.addEventListener("click", () => animate("prev"));

  document.addEventListener("DOMContentLoaded", () => {
    images.forEach((img, i) => {
      if (i === 0) {
        img.classList.add("active");
        img.style.opacity = 1;
        img.style.zIndex = 3;
      } else {
        img.style.opacity = 0;
        img.style.zIndex = 1;
      }
    });
    updateContent(0);
  });
</script>