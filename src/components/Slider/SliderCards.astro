<section>
  <article class="service">
    <div class="text">
      <div class="title">
        <h2 id="slide-title" class="slide-text">Title example</h2>
        <span id="slide-span" class="slide-text">span example</span>
      </div>
      <div class="texts">
        <p id="slide-text" class="slide-text">
          Lorem ipsum dolor sit amet consectetur adipisicing elit.
        </p>
        <a href="#" id="slide-btn" class="btn-mod slide-text">btn example</a>
      </div>
    </div>

    <div class="service-img">
      <img src="/slider/pageA.jpg" alt="Slide 1" class="slide-img active" />
      <img src="/slider/pageB.webp" alt="Slide 2" class="slide-img" />
      <img src="/slider/pageA.jpg" alt="Slide 3" class="slide-img" />
    </div>
  </article>

  <div class="controls-container">
    <button class="prev">←</button>
    <button class="next">→</button>
  </div>
</section>

<style>


  section {
    height: 100vh;
    width: 100%;
    color: var(--background);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .controls-container {
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;
    width: 90%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
  }

  .prev,
  .next {
    background: transparent;
    border: none;
    color: var(--background);
    cursor: pointer;
    font-size: 2vh;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10%;
    pointer-events: all;
  }

  .prev:hover,
  .next:hover {
    /* background: rgba(238, 238, 238, 1); */
    /* color: var(--contrast); */
  }
  .prev:active,
  .next:active {
    /* background: rgba(238, 238, 238, 1); */
    color: var(--background);
  }


  /* Estructura del contenido principal (texto e imagen) */
  .service {
    height: 80vh;
    width: 70dvw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
  }

  .text {
    display: flex;
    flex-direction: column;
    width: 40%;
    height: 90%; /* Altura en desktop */
    justify-content: space-between;
  }

  .title h2 {
    font-weight: 300;
    margin-bottom: 1rem;
  }

  .title span {
    font-size: 2rem;
    margin-left: 5%;
    opacity: 0.7;
  }

  .texts p {
    line-height: 1.6;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .btn-mod {
    width: fit-content;
    padding: 0.8em 1.5em;
    color: var(--background);
    text-decoration: none;
    transition: 0.3s ease, color 0.3s ease;
  }

  .btn-mod:hover {
    background: var(--background);
    color: var(--contrast);
  }

  .service-img {
    height: 80vh;
    width: 60vh;
    max-width: 50%;
    position: relative;
  }

  .service-img img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    will-change: opacity;
    border-radius: 0.7em;

  }

  /* La imagen activa */
  .service-img img.active {
    opacity: 1;
    z-index: 3;
  }

  /* --- Media Queries para Responsividad --- */
  @media screen and (max-width: 768px) {
    section {
      padding: 2rem 0;
    }

    .service {
      /* Altura mínima para asegurar espacio, pero el foco principal es el texto */
      min-height: 70vh;
      width: 90%;
      flex-direction: column;
      justify-content: space-around;
      align-items: flex-start;
      gap: 1rem;
    }

    .text {
      width: 100%;
        min-height: 40vh;
        max-height: 40vh;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        display: flex
;
        flex-direction: row;
        padding-bottom: 1rem;
        align-items: center;
        align-content: center;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: space-between;
    }

    .title h2 {
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    .title span {
      font-size: 0.9rem;
      margin-left: 0%;
    }

    .texts p {
      font-size: 1rem;
      /* Asegura que el párrafo ocupe el espacio restante dentro de texts */
      flex-grow: 1; 
    }

    .texts {
        display: flex; /* Mantiene flexbox para p y a */
        flex-direction: column;
        flex-grow: 1; /* Permite que el contenedor de los textos (p+a) crezca para llenar el espacio */
    }

    .btn-mod {
      width: 60%;
      font-size: 0.9rem;
      text-align: center;
      margin-top: auto; /* Empuja el botón hacia el final del .text si hay espacio */
    }

    .service-img {
      height: 60vw;
      width: 90vw;
      max-width: 100%;
      margin-top: 1rem;
    }

    .service-img img {
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
    }

    .controls-container {
      top: unset;
      bottom: 5%;
      left: 0;
      right: 0;
      width: 100%;
      justify-content: center;
      gap: 1.5rem;
    }
  }
</style>

<script type="module">
  import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

  const slidesData = [
    {
      title: "Web Services",
      span: "Web Development - Web Design - E-commerce - SEO",
      text: "We develop web solutions with scalable technologies adapted to the needs of the brand.",
      btnText: "More info",
      btnLink: "/services",
    },
    {
      title: "Creative Services",
      span: "Branding - Graphic Design - Content Creation",
      text: "We create unforgettable brands and designs that communicate values ​​and meet company objectives.",
      btnText: "More info",
      btnLink: "/services",
    },
    {
      title: "Consulting Services",
      span: "Re-branding - Digital Strategy - Technical Advice",
      text: "We plan and produce solutions to brand problems.",
      btnText: "More info",
      btnLink: "/services",
    },
  ];

  const images = document.querySelectorAll(".slide-img");
  const texts = document.querySelectorAll(".slide-text");
  const nextBtn = document.querySelector(".next");
  const prevBtn = document.querySelector(".prev");
  let index = 0;

  function updateContent(idx) {
    const data = slidesData[idx];
    document.getElementById("slide-title").textContent = data.title;
    document.getElementById("slide-span").textContent = data.span;
    document.getElementById("slide-text").textContent = data.text;
    const btn = document.getElementById("slide-btn");
    btn.textContent = data.btnText;
    btn.href = data.btnLink;
  }

  function animate(direction) {
    if (anime.running.length) return; // Evita animaciones si una ya está en curso

    const isNext = direction === "next";
    const oldIndex = index; // Guardamos el índice actual para la salida

    index = (index + (isNext ? 1 : slidesData.length - 1)) % slidesData.length;

    // Animar la salida de la imagen anterior
    anime({
      targets: images[oldIndex],
      opacity: 0,
      zIndex: 1,
      duration: 300,
      easing: "easeOutQuad",
      complete: () => {
        images[oldIndex].classList.remove("active");
        // Animar la entrada de la nueva imagen
        anime({
          targets: images[index],
          opacity: 1,
          zIndex: 3,
          duration: 300,
          easing: "easeInQuad",
          complete: () => {
            images[index].classList.add("active");
          }
        });
      }
    });

    // Animar textos (fade-in/out)
    anime({
      targets: texts,
      opacity: [0, 1],
      duration: 300,
      easing: "easeInOutQuad",
      begin: () => {
        updateContent(index);
      }
    });
  }

  // Event Listeners
  nextBtn.addEventListener("click", () => animate("next"));
  prevBtn.addEventListener("click", () => animate("prev"));

  // Inicialización al cargar el DOM
  document.addEventListener("DOMContentLoaded", () => {
    images.forEach((img, i) => {
      if (i === 0) {
        img.classList.add("active");
        img.style.opacity = 1;
        img.style.zIndex = 3;
      } else {
        img.style.opacity = 0;
        img.style.zIndex = 1;
      }
    });
    updateContent(0);
  });
</script>