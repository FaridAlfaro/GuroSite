---
---

   <header>
     <div class="text">
       <h1 class="animated-title">GLOBAL BRANDING & WEB SOLUTIONS STUDIO FROM CORDOBA.</h1>
     </div>
   <video src="/video/file.mp4" autoplay muted playsinline loop></video>

   </header>
 


<style>

   header {
      position: relative;
      height: 100vh;
      width: 100%;
      overflow: hidden;
      transition: ease 0.5s;
      animation: ease 0.5s;
      background-color: var(--background);
   }
   .text{
      height: 60%;
      background: var(--contrast);
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--background);
      padding-left: 2%;
      padding-right: 2%;
      h1{
         font-weight: 500;
         font-size: clamp(24px, 8vh, 100px);
   }
}
  


 
   video {
  position: absolute;
  top: 60vh; /* empieza justo debajo del header */
  left: 0;
  width: 100%;
  height: auto;
  z-index: 999;
  pointer-events: none;
}

   @media (max-width: 767px) {
      header {
      position: relative;
      height: 100vh;
      width: 100%;
      overflow: hidden;
      transition: ease 0.5s;
      animation: ease 0.5s;
   }
   .text{
      height: 60vh;
      background: var(--contrast);
      display: flex;
      justify-content: center;
      align-items: flex-end;
      color: var(--background);
      padding-left: 2%;
      padding-right: 2%;
      h1{
         font-weight: 500;
         font-size: 2rem;
   }
}
  


 
   video {
  position: absolute;
  top: 60vh; /* empieza justo debajo del header */
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  pointer-events: none;
  object-fit: cover;
   }
}
</style>

<script type="module">
  import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js";

  const video = document.querySelector("video");
  const header = document.querySelector("header");

  let animating = false;
  let videoTop = 60; // en vh
  let scrollLocked = true;

  lockScroll();

  function lockScroll() {
    scrollLocked = true;
    document.documentElement.classList.add("lock-scroll");
    document.body.classList.add("lock-scroll");
  }

  function unlockScroll() {
    scrollLocked = false;
    document.documentElement.classList.remove("lock-scroll");
    document.body.classList.remove("lock-scroll");
  }

  window.addEventListener("wheel", handleScroll, { passive: false });

  function handleScroll(e) {
    const direction = e.deltaY > 0 ? "down" : "up";

    if (animating) return;

    if (scrollLocked) {
      e.preventDefault();

      if (direction === "down") {
        animating = true;
        anime({
          targets: video,
          top: "0vh",
          easing: "easeOutQuad",
          duration: 800,
          complete: () => {
            // Esperar medio segundo antes de desbloquear
            setTimeout(() => {
              animating = false;
              videoTop = 0;
              unlockScroll();
            }, 500);
          }
        });
      }
    } else {
      if (window.scrollY <= 0 && direction === "up") {
        e.preventDefault();

        animating = true;
        lockScroll();
        anime({
          targets: video,
          top: "60vh",
          easing: "easeOutQuad",
          duration: 500,
          complete: () => {
            animating = false;
            videoTop = 60;
          }
        });
      }
    }
  }

  let startY = 0;

  window.addEventListener("touchstart", (e) => {
    startY = e.touches[0].clientY;
  }, { passive: false });

  window.addEventListener("touchmove", (e) => {
    const currentY = e.touches[0].clientY;
    const deltaY = startY - currentY;

    if (deltaY > 10) {
      e.deltaY = 100;
      handleScroll(e);
    }

    if (deltaY < -10) {
      e.deltaY = -100;
      handleScroll(e);
    }
  }, { passive: false });
</script>

 

