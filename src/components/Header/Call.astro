<section class="call-to-action">
  <span class="etiqueta">- Who we are</span>

  <h4 class="titulo-principal">
    A Borderless<br />
    <span class="light">Creative Company</span><br />
    <strong>Where Technology<br />and Emotion Meet.</strong>
  </h4>
  <p class="descripcion">
    We help SMBs stand out with bold branding, high-performance websites, and smart automation.
  </p>
  <a href="/about" class="btn modifier">About →</a>
  <div class="video-container" id="rootNode">
    <video
      src="/video/file.mp4"
      class="video"
      autoplay
      loop
      muted
      playsinline
    >
    </video>
  </div>
</section>


<style >
  .call-to-action {
    position: relative;
    height: 100vh;
    padding: 0% 5%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    /* box-sizing: border-box; */
    /* overflow: hidden; */
    color: var(--contrast);
  }

  .etiqueta {
    font-size: clamp(0.9rem, 2vh, 24px);
    font-weight: 300;
    letter-spacing: 0.05rem;
    /* border-left: 2px solid #000; */
    padding-left: 0.5rem;
    margin-bottom: 1rem;
  }

  .titulo-principal {
    line-height: 1.2;
    margin: 0;
    width: 100%;
    font-style: italic;
    font-weight: normal;

  }

  .titulo-principal .light {
    font-style: normal;
    color: var(--contrast);
  }

  .titulo-principal strong {
    font-style: normal;

  font-weight: bold;
  background: url("/gif/fondoazul.gif") no-repeat center center;
  background-size: cover;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
}

  .descripcion {
    font-weight: 400;
    max-width: 70%;
    line-height: 1.6;
  }

  .video-container {
    width: 100%;
    height: 90vw;
    z-index: 2;
    /* transform: translateX(-5%); */
        border-radius: 0.7em;

    overflow: hidden;
    animation: fade-up ease-in-out both;
    animation-timeline: view();
    animation-range: 0% 35%;
    
  }

  .video-container video {
    height: 100%;
    width: 100%;
    object-fit: cover;
    border-radius: 3px;
   
  }
  .modifier {
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }

  @media (min-width: 1280px) {
    .call-to-action {
    position: relative;
    height: 100vh;
    padding: 10% 5%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
    box-sizing: border-box;
    /* overflow: hidden; */
    color: var(--contrast);
  }

  .etiqueta {
    font-weight: 300;
    letter-spacing: 0.05rem;
    padding-left: 0.5rem;
    margin-bottom: 1rem;
  }

  .titulo-principal {
    line-height: 1.2;
    margin: 0;
    width: 100%;
  }

  .titulo-principal .light {
    color: var(--contrast);
    font-style: normal;

  }

  .titulo-principal strong {
    font-style: normal;

  font-weight: bold;
  background: url("/gif/fondoazul.gif") no-repeat center center;
  background-size: cover;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
}


  .descripcion {
    font-weight: 300;
    max-width: 50%;
    line-height: 1.6;
  }

  .video-container {
    position: absolute;
    bottom: 15%;
    right: 5%;
    height: 40vh;
    width: calc(40vh * 1.618);
  }

  .video-container video {
    height: 40vh;
    width: calc(40vh * 1.618);
    object-fit: cover;
    border-radius: 3px;
  }
  .modifier {
    position: absolute;
    bottom: 5%;
    right: 5%;
  }
}
</style>
