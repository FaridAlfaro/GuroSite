---
import Layout from "../layouts/Layout.astro"
import Card from "../components/interface/Card.astro";
import { getCollection } from "astro:content"
const services = await getCollection("services")

// Agrupar servicios por categoría
const categories = [
  "Entidades deportivas",
  "Autonomos",
  "E-Commerce",
  "Consultorios medicos",
  "Gastronomicos",
  "Emprendedores"
];

const servicesByCategory = {};
categories.forEach(cat => {
  servicesByCategory[cat] = services.filter(s => s.data.category === cat);
});
---

<Layout title="Services">
  <main class="container">
    <div class="services-title">
      <h1 class="title">SERVICES</h1>
    </div>
    {
      categories.map(category => (
        servicesByCategory[category].length > 0 && (
          <section class="category-section" key={category}>
            <h2 class="category-title">{category}</h2>
            <div class="cards-row">
              {
                servicesByCategory[category].map(service => (
                  <Card key={service.data.title} {...service.data} />
                ))
              }
            </div>
          </section>
        )
      ))
    }
    <h2>Servicios específicos</h2>
    <p style="width: 80vw;">Consúltanos respecto a tus necesidades y cotizaremos tus servicios.</p>
    <a href="https://api.whatsapp.com/send?phone=543512401402&text=Hola!%20Estoy%20interesado%20en%20sus%20servicios%20para%3A%20" class="btn">Whatsapp &rarr;</a>
  </main>
</Layout>

<style>
  main{
    background: var(--contrast);
    width: 100%;
  }
  .services-title{
    height: 60vh;
    width: fit-content;
    display: flex;
    text-align: left;
    align-items: center;
    background-color: var(--contrast);
    justify-content: flex-start;
    align-content: center;
    flex-direction: row;
    h1{
      font-size: clamp(24px, 7vh, 60px);
      color: var(--background);
      font-weight: 500;
    }
  }
  .category-section {
    width: 100%;
    margin-bottom: 3rem;
  }
  .category-title {
    color: var(--background);
    font-size: 2rem;
    margin: 2rem 0 1rem 0;
    font-weight: 600;
    text-align: left;
  }
  .cards-row {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: flex-start;
    align-items: stretch;
    width: 100%;
  }
  .off{
    width:fit-content;
    color: var(--background);
    margin: 1rem 10%;
    display: flex;
    align-items: center;
    justify-content: left;
    position: relative;
    background: red;
    span{
      position: absolute;
      top: -40%;
      font-size: .9rem;
      text-align: center;
    }
  }
  .offdes{
    color: var(--background);
    text-align: left;
    width: 50%;
    font-weight: 500;
    font-size: .9rem;
    line-height: 1.5;
    margin: 0 10%;
  }
  .container{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .button{
    color: var(--contrast);
    border-radius: 50px;
    width: 30%;
    border: 1px solid var(--contrast);
    padding: 1rem;
    text-align: center;