---
import Layout from "../layouts/Layout.astro";
import Form from "../components/contacto/Form.astro";
---

<Layout title="Contact Us"> {/* Changed title */}
  <section class="contacto"> {/* 'contacto' class name is fine, it's internal */}
    <div class="titular"> {/* 'titular' class name is fine */}
      <h1>
        <span class="s1">Ready</span>
        <br />to<span class="s2"> work</span><br /><span class="s3"
          >together?</span
        >
      </h1>
      <div class="correo"> 
        <a
          href="mailto:info@guro.com?Subject=Interested%20in%20your%20services" 
          >info@guro.com</a
        >
      </div>
      <div class="correo">
        <a
          href="https://wa.me/3512401402/?text=Hey!%20Interested%20in%20working%20together" 
        >
          +54 9 351 240-1402 
        </a>
      </div>
    </div>
    <div class="formulario">
      <div class="accion"> 
        <span></span> 
        <div class="textos"> 
          <h2>We're ready to bring your project to life.<br />Are you?</h2> 
          <p class="a">
            Feel free to reach out to discuss your ideas! We're excited to partner
            with you and take your project to the next level. 
          </p>
        </div>
        <img src="/gif/computadora.gif" alt="" /> 
      </div>
      <Form />
    </div>
  </section>
</Layout>

<style>
 
  .titular {
    h1 {
      color: var(--background);
      font-weight: 300;
      font-size: clamp(14px, 7.77vh, 80px);
    }
  }
  .s1,
  .s3 {
    font-weight: 300;
    color: var(--background);
  }
  .s2 {
    color: transparent;
    background-image: url(/gif/fondoazul.gif);
    background-clip: text;
    font-weight: bold;
    font-style: italic;
    cursor: cell;
    transition: ease 1s;
  }

  .correo {
    margin: 10px 0;
    cursor: pointer;
    transition: ease 1s;
    a {
      text-decoration: none;
      color: var(--background);
      font-size: clamp(12px, 5.55vh, 18px);
    }
    a:hover {
      transition: ease 1s;
    }
  }
  .correo:hover {
    transition: ease 0.5s;
    background-clip: text;
    color: red;
  }

  .contacto {
    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: 1fr 1fr;
    width: 100vw;
    padding: 0 5%;
    height: 100vh;
    align-items: center;
    background-color: var(--contrast);
    color: var(--background);
    opacity: 1;
    overflow: hidden;
  }
  .formulario {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 80%;
    margin: 0;
  }
  p {
    font-size: clamp(12px, 5.55vh, 18px);
    margin: 0;
    padding: 0;
  }
  .textos {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    height: 100%;
    width: auto;
    h2 {
      font-size: clamp(14px, 5.55vh, 24px);
      font-weight: normal;
      margin: 0 0 3% 0;
      padding: 0;
    }
  }
  .accion {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    height: clamp(18%, 10vh, 20%);
    margin: 10% 0;
    overflow: hidden;
    span {
      padding: 0;
      min-width: 2px;
      height: 100%;
      background: var(--background);
      margin: 0 5% 0 0;
    }
    img {
      width: 20%;
    }
  }
  @media (max-width: 700px) {
    .contacto {
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: auto;
      height: auto;
    }
    .titular {
      margin-top: 20%;
      width: 100%;
      font-size: clamp(12px, 7vw, 28px);
    }
    .formulario {
      width: 100%;
      height: 50%;
      margin: 10% 5%;
      padding: 0;
    }
    .accion {
      display: none;
    }
  }
</style>
