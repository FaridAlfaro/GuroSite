---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((service) => ({
    params: { id: service.data.link },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
const { title, text, price, link, contact } = data;
const { Content } = await render(service);
---

<Layout title={title}>
  <section class="service-detail">
    <div class="title-container">
      <h1 class="title">{title}</h1>
      <a href="404" class="hero-call">Ver video resúmen</a>
    </div>

    <div class="content-wrapper">  <div class="content">
        <Content />
      </div>
    </div>

    <div class="contact-wrapper">  <div class="contact">
        <p class="price">
          Agenda una asesoría y adquirí este servicio:<br />
          {price}
        </p>
        <a href={contact} class="btn contact-button"> Cotizar &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-detail {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* Changed from center */
    align-items: center;
    background: var(--background);
    color: var(--contrast);
  }

  /* title-container styles remain the same */
  .title-container {
    height: 90vh;
    background-color: var(--contrast);
    color: var(--background);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100vw;
  }

  .content-wrapper {  /* Styling the content section */
    width: 100%;
    padding: 4rem 0;
    background: linear-gradient(to bottom, var(--background), #f9f9f9); /* Subtle gradient */
    border-radius: 20px 20px 0 0; /* Rounded corners at the top */
    margin-top: -3rem; /* Overlap with title-container */
    z-index: 10; /* Ensure it's above the title-container */
    position: relative; /* For z-index */
  }

  .content {
    display: flex;
    flex-direction: column; /* Changed to column for better layout */
    justify-content: flex-start;
    align-items: flex-start;
    width: 80%;
    max-width: 900px; /* Added max-width */
    margin: 0 auto; /* Center the content */
    line-height: 1.6; /* Increased line height */
  }

  .content li {
    line-height: 1.8; /* Increased line height for list items */
    width: 100%; /* List items take full width */
    padding-left: 1.5rem; /* Indentation for list items */
    position: relative;
    animation: sideLeft linear both 1s;
    animation-timeline: view();
    animation-range: 0% 50%;
  }

  .content li::before { /* Custom bullet points */
    content: "•";
    position: absolute;
    left: 0;
    color: var(--azul3); /* Accent color */
  }

  .content h1 {
    border-bottom: 2px solid var(--azul3); /* Accent color */
    width: auto;
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
  }

  .content h2,
  .content h3 {
    margin-top: 2rem;
    margin-bottom: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    border-bottom: 2px solid var(--gris1); /* Lighter color */
    width: auto;
    padding-bottom: 0.3rem;
  }

  .contact-wrapper {  /* Styling the contact section */
    width: 100%;
    padding: 3rem 0;
    background: #f9f9f9; /* Match content background */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .contact {
    max-width: 600px;
    width: 80%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .price {
    color: var(--gris2); /* Darker text */
    line-height: 1.7;
  }

  .contact-button {  /* Styling the button */
    background: var(--azul3);
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 5px;
    font-weight: 500;
  }

  /* Existing animations */
  @keyframes sideLeft {
    from {
      transform: translateX(-20px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
</style>